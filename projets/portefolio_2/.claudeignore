# ==========================================
# Claude Code Exclusion Rules (Workspace LaTeX)
# ==========================================
# Note: Secrets (.env, *.key, *.pem, *.secret, *.local.json) are denied globally in
# C:\Users\guill\.claude\settings.json (permissions.deny), and OS/Python caches are
# excluded globally in C:\Users\guill\.gitignore_global + VS Code search.exclude.

# Python Virtualenv
.venv/

# LaTeX Disposable Build Artifacts
# Note: *.pdf, *.log, *.blg and *.bbl are purposely ALLOWED so the AI can
# visually inspect compiled PDFs and diagnose LaTeX/Biber compilation errors!
*.aux
*.bcf
*.run.xml
*.toc
*.lof
*.lot
*.loi
*.out
*.tdo
*.idx
*.ilg
*.ind
*.upa
*.upb
*.synctex.gz
*.synctex
*.fls
*.fdb_latexmk
*.xdv
*.nav
*.snm
*.vrb
_minted-*/
auto/
