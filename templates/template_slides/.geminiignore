# ==========================================
# Gemini CLI Exclusion Rules (Workspace LaTeX)
# ==========================================
# Note: OS/Python noise (__pycache__, *.pyc, dist/, .DS_Store, Thumbs.db) is moved
# to global VS Code search.exclude & C:\Users\guill\.gitignore_global.
# Secrets remain listed locally because Gemini CLI reads .geminiignore at workspace root.

# Secrets & Environment variables
.env
.env.*
*.key
*.pem
*.secret
*.local.json

# Python Virtualenv
.venv/

# LaTeX Disposable Build Artifacts
# Note: *.pdf, *.log, *.blg and *.bbl are purposely ALLOWED so the AI can
# visually inspect compiled PDFs and diagnose LaTeX/Biber compilation errors!
*.aux
*.bcf
*.run.xml
*.toc
*.lof
*.lot
*.loi
*.out
*.tdo
*.idx
*.ilg
*.ind
*.upa
*.upb
*.synctex.gz
*.synctex
*.fls
*.fdb_latexmk
*.xdv
*.nav
*.snm
*.vrb
_minted-*/
auto/
