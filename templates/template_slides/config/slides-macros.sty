  enhanced,
  colback=SlideCardSurface,
  colframe=SlideBorder,
  coltext=SlideFg,
  coltitle=SlideTitleFg,
  colbacktitle=SlideCardSurface,
  borderline north={2pt}{0pt}{SlidePrimary},
  fonttitle=\bfseries\sffamily\small,
  title={#2},
  before upper=\RaggedRight\small,
  boxrule=0.45pt,
  arc=2.5pt,
  left=8pt, right=8pt, top=5pt, bottom=5pt,
  toptitle=4pt, bottomtitle=1.5pt,
  before skip=3pt, after skip=3pt,
  #1
}

\newtcolorbox{alertcard}[2][]{%
