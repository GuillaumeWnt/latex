% --- Notations mathématiques sémantiques (compatibles ClasseGuillaume) ---
\newcommand{\vect}[1]{\boldsymbol{\mathbf{#1}}}
\newcommand{\mat}[1]{\boldsymbol{\mathbf{#1}}}

\newcommand{\setR}{\mathbb{R}}
\newcommand{\setN}{\mathbb{N}}
\newcommand{\setZ}{\mathbb{Z}}
\newcommand{\setC}{\mathbb{C}}

\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\DeclarePairedDelimiterX{\scal}[2]{\langle}{\rangle}{#1 , #2}

\newcommand{\diff}{\mathop{}\!\mathrm{d}}

\DeclareMathOperator*{\argmin}{\arg\min}
\DeclareMathOperator*{\argmax}{\arg\max}
\DeclareMathOperator{\trace}{\mathrm{Tr}}
\DeclareMathOperator{\diag}{\mathrm{diag}}

% --- Balisage textuel sémantique adaptatif ---
\newif\ifClasseGuillaumeSlides@darkcontext
\ClasseGuillaumeSlides@darkcontextfalse

\newcommand{\term}[1]{\textbf{\textcolor{SlidePrimary}{#1}}}

\newcommand{\code}[1]{%
  \ifbool{moloch@standout}{%
    \texttt{\textcolor{white}{#1}}%
  }{%
    \ifClasseGuillaumeSlides@darkcontext%
      \texttt{\textcolor{white}{#1}}%
    \else%
      \ifdarktheme%
        \texttt{\textcolor{SlideSecondary}{#1}}%
      \else%
        \texttt{\textcolor{ThesisPrimary!92!black}{#1}}%
      \fi%
    \fi%
  }%
}

