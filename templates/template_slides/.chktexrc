# ==============================================================================
# .chktexrc — Configuration ChkTeX adaptée au français et à template_slides
# ==============================================================================

TabSize = 2

CmdLine
{
  -n1 -n12 -n20 -n24 -n26 -n36 -n46
}

Linker
{
  \autocite \parencite \supercite
}

Silent
{
  \LaTeX \LuaLaTeX \TeX
  \toprule \midrule \bottomrule \addlinespace
  \maketitle \appendix \tableofcontents \printbibliography
}

WipeArg
{
  \code:{}
  \term:{}
  \kpibadge:[]{}
  \metriccard:[]{}{}[]
  \minimalstat:[]{}{}[]
  \stepitem:[][]{}{}{}
  \stepitemrow:[]{}{}{}
  \floatingcard:[][]{}{}{}
  \tiltframe:[][]{}
  \diagonalpanel:[][]{}
  \circlebadgevisual:[]{}
  \usebandcanvas:[][][]
  \userailcanvas:[][]
  \railpoint:[]{}{}{}
  \processstep:[]{}{}{}
  \timelineevent:[][]{}{}{}
  \funnellevel:[]{}{}{}
  \cyclestep:[]{}{}{}
  \standoutslide:[]{}
  \sourcenote:{}
  \takeaway:{}
  \category:{}
  \event:{}
  \location:{}
  \covervisual:{}
  \footertext:{}
  \slideasset:{}
  \url:{}
  \nolinkurl:{}
  \href:{}{}
  \lstinline:[]{}
  \includestandalone:[]{}
}
