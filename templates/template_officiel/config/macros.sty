\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{config/macros}[2026/11/12 v2.0 Custom Macros for mythesis]

% --- Notations mathématiques sémantiques ---
% Vecteurs et matrices en gras droit / italique
\newcommand{\vect}[1]{\boldsymbol{\mathbf{#1}}}
\newcommand{\mat}[1]{\boldsymbol{\mathbf{#1}}}

% Ensembles usuels
\newcommand{\setR}{\mathbb{R}}
\newcommand{\setN}{\mathbb{N}}
\newcommand{\setZ}{\mathbb{Z}}
\newcommand{\setC}{\mathbb{C}}

% Délimiteurs extensibles via mathtools
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\DeclarePairedDelimiterX{\scal}[2]{\langle}{\rangle}{#1 , #2}

% Symbole différentiel droit pour le calcul intégral
\newcommand{\diff}{\mathop{}\!\mathrm{d}}

% Opérateurs d'optimisation
\DeclareMathOperator*{\argmin}{\arg\min}
\DeclareMathOperator*{\argmax}{\arg\max}
\DeclareMathOperator{\trace}{\mathrm{Tr}}
\DeclareMathOperator{\diag}{\mathrm{diag}}

% --- Balisage textuel sémantique ---
% Bascule automatique de contraste pour \code{...} dans les bandeaux sombres
\newif\ifmythesis@darkbanner
\mythesis@darkbannerfalse

% Terme technique introduit pour la première fois
\newcommand{\term}[1]{\textbf{\textcolor{ThesisPrimary}{#1}}}

% Fragment de code en ligne (adaptatif clair/sombre)
\newcommand{\code}[1]{%
  \ifmythesis@darkbanner
    \texttt{\textcolor{white}{#1}}%
  \else
    \texttt{\textcolor{ThesisPrimary!92!black}{#1}}%
  \fi
}

% --- Notes marginales éditoriales persistantes (publiées dans l'ouvrage final) ---
% Contrairement à \todoH (réservé à la relecture collaborative), \noteMarge produit
% une note typographique pérenne dans la marge extérieure (inspirée de Bringhurst/Tufte).
\NewDocumentCommand{\noteMarge}{O{0pt} +m}{%
  \marginnote{%
    \noindent{\color{ThesisAccent}\rule{0.45\linewidth}{1.2pt}}{\color{ThesisSecondary!30}\rule{0.55\linewidth}{0.5pt}}\par\vspace{2pt}%
    \RaggedRight\scriptsize\sffamily\color{ThesisMuted}#2\par%
  }[#1]%
}

% --- Environnements visuels (tcolorbox) ---

