  breakable,
  colback=ThesisPrimary!3,
  colframe=ThesisPrimary!28,
  colbacktitle=ThesisPrimary!11,
  coltitle=ThesisPrimary,
  borderline west={3.2pt}{0pt}{ThesisPrimary},
  fonttitle=\bfseries\sffamily\small,
  title={#1},
  left=10pt,
  right=10pt,
  top=6pt,
  bottom=6pt,
  toptitle=3pt,
  bottomtitle=3pt,
  arc=2.5pt,
  boxrule=0.6pt,
  before skip=12pt,
  after skip=12pt
}

% 2. Boîte d'attention / Point critique (Mettant en valeur la couleur ThesisAccent)
