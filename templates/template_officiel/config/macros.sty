% Déclaration des alias cleveref dans le préambule (avant le hook \AtBeginDocument de cleveref)
\crefname{hypocounter}{hypothèse}{hypothèses}
\Crefname{hypocounter}{Hypothèse}{Hypothèses}
\crefname{deficounter}{définition}{définitions}
\Crefname{deficounter}{Définition}{Définitions}
\crefname{lstlisting}{listing}{listings}
\Crefname{lstlisting}{Listing}{Listings}
\crefname{illustration}{illustration}{illustrations}
\Crefname{illustration}{Illustration}{Illustrations}
% Surcharge post-babel pour remplacer la traduction par défaut "Liste" de lstlisting par "Listing"
\AddToHook{begindocument/end}{%
  \crefname{lstlisting}{listing}{listings}%
  \Crefname{lstlisting}{Listing}{Listings}%
}

% --- Alternance dynamique des géométries de page (KOMA natif + geometry) ---
% Suivi de la géométrie courante pour restauration intelligente après une pageDesign
\newcommand{\currentGeometryCmd}{\geometrieStandard}

% 1. Restauration de la géométrie canonique KOMA par défaut (DIV=12 + BCOR)
\newcommand{\geometrieStandard}{%
  \cleardoublepage%
  \renewcommand{\currentGeometryCmd}{\geometrieStandard}%
  \restoregeometry%
}

% 2. Géométrie Large / Pleine Page (Style B - geometry) : marges réduites à 1.5 cm pour grands tableaux
%    Préserve automatiquement le décalage de reliure (\mythesis@bcor) en mode print !
\newcommand{\geometrieLarge}{%
  \cleardoublepage%
  \renewcommand{\currentGeometryCmd}{\geometrieLarge}%
  \newgeometry{
    left=1.5cm, right=1.5cm,
    top=2.0cm, bottom=2.0cm,
    bindingoffset=\mythesis@bcor,
    headheight=20pt, headsep=14pt,
    footskip=26pt, footnotesep=8pt,
    marginparwidth=0mm, marginparsep=0mm
  }%
}
\let\geometrieExemple\geometrieLarge

% 3. Géométrie Traitement de Texte / Word (Style C - geometry) : marges symétriques de 2.5 cm partout
%    Conforme aux instructions universitaires et aux grilles de relecture académiques.
\newcommand{\geometrieWord}{%
  \cleardoublepage%
  \renewcommand{\currentGeometryCmd}{\geometrieWord}%
  \newgeometry{
    left=2.5cm, right=2.5cm,
    top=2.5cm, bottom=2.5cm,
    bindingoffset=\mythesis@bcor,
    headheight=20pt, headsep=16pt,
    footskip=28pt, footnotesep=10pt,
    marginparwidth=2.0cm, marginparsep=2.5mm
  }%
}
\let\geometrieAnnotation\geometrieWord

% 4. Géométrie spécifique pour couverture ou page de garde sans en-tête
\newcommand{\geometrieCouverture}{%
  \cleardoublepage%
  \newgeometry{
    left=1.8cm, right=1.8cm,
    top=1.8cm, bottom=1.8cm,
    bindingoffset=0mm,
    headheight=0pt, headsep=0pt,
    footskip=0pt,
    marginparwidth=0mm, marginparsep=0mm
  }%
}

% 5. Géométrie libre sur-mesure à la volée (compatible ClasseGuillaume)
\newcommand{\geometrieLibre}[1]{%
  \cleardoublepage%
  \newgeometry{
    headheight=20pt, headsep=16pt,
    footskip=28pt, footnotesep=8pt,
    marginparwidth=0mm, marginparsep=0mm,
    bindingoffset=0mm,
    #1
  }%
}

% 6. Environnements autonomes avec restauration automatique en fin de bloc
\newenvironment{WideGeometry}{%
  \geometrieLarge%
}{%
  \geometrieStandard%
}

\newenvironment{WordGeometry}{%
  \geometrieWord%
}{%
  \geometrieStandard%
}

\newenvironment{AnnotationGeometry}{%
  \geometrieAnnotation%
}{%
  \geometrieStandard%
}

% 7. Environnement pageDesign (hérité de ClasseGuillaume et perfectionné) :
%    Offre une liberté totale pour designer des pages spécifiques (couverture, planche
%    graphique, poster, synthèse exécutive) sans en-tête ni logo, puis restaure
%    automatiquement la géométrie, l'état du logo et le style de page à la sortie !
\NewDocumentEnvironment{pageDesign}{O{left=1.5cm, right=1.5cm, top=1.6cm, bottom=1.6cm}}{%
  \cleardoublepage%
  \let\savedGeometryCmd\currentGeometryCmd%
  \iflogoactive\savedlogotrue\else\savedlogofalse\fi%
  \masquerLogo%
  \geometrieLibre{#1}%
  \pagestyle{empty}%
  \thispagestyle{empty}%
}{%
  \cleardoublepage%
  \ifsavedlogo\afficherLogo\fi%
  \savedGeometryCmd%
  \pagestyle{scrheadings}%
}

% --- Système d'annotations collaboratives \todoH ---
\ifusetodos
  % Profils de relecteurs préconfigurés avec signature et couleur
  \todostyle{AuthorStyle}{author=Auteur, color=ThesisPrimary!20, bordercolor=ThesisPrimary!60, shadow}
  \todostyle{DirectorStyle}{author=Directeur, color=ThesisSecondary!25, bordercolor=ThesisSecondary!70, shadow}
  \todostyle{ReviewerStyle}{author=Rapporteur, color=ThesisAccent!25, bordercolor=ThesisAccent!70, shadow}
  % Alias de compatibilité ClasseGuillaume
  \todostyle{GuillaumeStyle}{author=Guillaume, color=ThesisPrimary!20, bordercolor=ThesisPrimary!60, shadow}
  \todostyle{MarieStyle}{author=Marie, color=ThesisSecondary!25, bordercolor=ThesisSecondary!70, shadow}
  \todostyle{FloraStyle}{author=Flora, color=ThesisAccent!25, bordercolor=ThesisAccent!70, shadow}
  \todostyle{TestStyle}{author=Test, color=ThesisMuted!25}
  \todostyle{BlancStyle}{color=ThesisBackground}

  % Détermination automatique de la couleur de surlignage assortie au profil si [couleur] est omis
  \newcommand{\mythesis@resolve@todocolor}[1]{%
    \def\mythesis@hlcolor{ThesisPrimary!22}%
    \IfSubStr{#1}{Director}{\def\mythesis@hlcolor{ThesisSecondary!25}}{}%
    \IfSubStr{#1}{Marie}{\def\mythesis@hlcolor{ThesisSecondary!25}}{}%
    \IfSubStr{#1}{Reviewer}{\def\mythesis@hlcolor{ThesisAccent!25}}{}%
    \IfSubStr{#1}{Flora}{\def\mythesis@hlcolor{ThesisAccent!25}}{}%
  }

  \NewDocumentCommand{\todoH}{O{AuthorStyle} o m +m}{%
    \if@todonotes@disabled
      #4%
    \else
      \IfNoValueTF{#2}{%
        \mythesis@resolve@todocolor{#1}%
        \def\mythesis@todoopts{#1}%
      }{%
        \def\mythesis@hlcolor{#2}%
        \def\mythesis@todoopts{#1, color=#2}%
      }%
      \IfSubStr{\detokenize{#3}}{\@backslashchar}{%
        % Commande LaTeX détectée (ex: \url) : pas de troncature, caption propre pour .tdo
        \expandafter\todo\expandafter[\mythesis@todoopts, caption={\detokenize{#3}}]{#3}%
      }{%
        % Texte simple : troncature dynamique si > 30 caractères + infobulle interactive
        \StrLen{#3}[\longueurTexte]%
        \ifnum\longueurTexte>30
          \StrLeft{#3}{30}[\apercu]%
          \expandafter\todo\expandafter[\mythesis@todoopts, caption={#3}]{\pdftooltip{\apercu...}{#3}}%
        \else
          \expandafter\todo\expandafter[\mythesis@todoopts, caption={#3}]{\pdftooltip{#3}{#3}}%
        \fi
      }%
      \expandafter\hyperref\expandafter[\expandafter t\expandafter a\expandafter b\expandafter l\expandafter e\expandafter _\expandafter t\expandafter o\expandafter d\expandafter o\expandafter s\expandafter]\expandafter{\expandafter\highLight\expandafter[\mythesis@hlcolor]{#4}}%
    \fi
  }

  % Tableau de bord des révisions sécurisé (avec alias \tableDesTodos de ClasseGuillaume)
  \NewDocumentCommand{\thesistodolist}{O{Tableau de Bord des Révisions et Tâches de Rédaction}}{%
    \cleardoublepage
    \phantomsection
    \label{table_todos}%
    \begingroup
      \listoftodos[#1]%
    \endgroup
  }
  \let\tableDesTodos\thesistodolist
\else
  % En mode publication finale ou print sans l'option todos : neutralisation totale
  \NewDocumentCommand{\todoH}{O{} o m +m}{#4}
  \NewDocumentCommand{\thesistodolist}{O{}}{\relax}
  \let\tableDesTodos\thesistodolist
\fi

% --- Configuration du style de code source externe (listings/) ---
\lstdefinestyle{mythesiscode}{
  basicstyle=\ttfamily\footnotesize,
  backgroundcolor=\color{ThesisBackground},
  keywordstyle=\color{ThesisPrimary}\bfseries,
  commentstyle=\color{ThesisMuted}\itshape,
  stringstyle=\color{ThesisAccent},
  numberstyle=\tiny\sffamily\color{ThesisMuted},
  numbers=left,
  numbersep=8pt,
  stepnumber=1,
  frame=single,
  rulecolor=\color{ThesisSecondary!30},
  framesep=5pt,
  breaklines=true,
  breakatwhitespace=true,
  tabsize=2,
  showstringspaces=false,
  captionpos=b,
  keepspaces=true
}
\lstset{style=mythesiscode}

% --- Macros d'interactivité PDF intelligente : profil écran vs profil impression ---

\ifprintversion
  % ============================================================================
  % PROFIL IMPRESSION PAPIER (print) :
  % - Neutralisation totale des calques PDF pour un rendu 100% statique et lisible
  % - Omission complète des boutons de bascule (inopérants sur papier)
  % - Aplatissement linéaire propre des vues pour le lecteur papier et l'imprimeur
  % ============================================================================
  \RenewDocumentEnvironment{ocg}{O{} m m m}{%
    \begingroup
  }{%
    \endgroup
  }

  % Les boutons interactifs sont strictement omis sur le papier
  \newcommand{\ocgbutton}[2]{\relax}
  \newcommand{\ocgselectbutton}[3]{\relax}

  % Gestionnaire d'affichage statique pour l'impression papier
  \long\def\@thesis@ocgstack@both#1#2{#1\par\vspace{10pt}\noindent#2}
  \long\def\@thesis@ocgstack@first#1#2{#1}
  \long\def\@thesis@ocgstack@second#1#2{#2}

  \NewDocumentCommand{\ocgstack}{O{both} +m +m}{%
    \par\noindent%
    \csname @thesis@ocgstack@#1\endcsname{#2}{#3}%
    \par%
  }

  \NewDocumentCommand{\ocgstackthree}{O{all} +m +m +m}{%
    \par\noindent%
    #2\par\vspace{10pt}\noindent#3\par\vspace{10pt}\noindent#4\par%
  }
\else
  % ============================================================================
  % PROFIL ÉCRAN NUMÉRIQUE (screen) :
  % - Calques PDF interactifs dynamiques (paquet ocgx2)
  % - Boutons cliquables de bascule instantanée stylisés
  % - Superposition géométrique parfaite TikZ à l'ancrage (north west à 0,0)
  % ============================================================================
  \newcommand{\ocgbutton}[2]{%
    \switchocg{#1}{%
      \tcbox[
        enhanced,
        on line,
        arc=3pt,
        boxrule=0.7pt,
        colframe=ThesisSecondary!65,
        colback=ThesisSecondary!8,
        boxsep=0pt,
        left=6pt, right=6pt, top=3.5pt, bottom=3.5pt
      ]{\footnotesize\sffamily\bfseries\textcolor{ThesisPrimary}{\textcolor{ThesisAccent}{$\blacktriangleright$}\enspace #2}}%
    }%
  }

  \newcommand{\ocgselectbutton}[3]{%
    \actionsocg{}{#1}{#2}{%
      \tcbox[
        enhanced,
        on line,
        arc=3pt,
        boxrule=0.7pt,
        colframe=ThesisSecondary!65,
        colback=ThesisSecondary!8,
        boxsep=0pt,
        left=6pt, right=6pt, top=3.5pt, bottom=3.5pt
      ]{\footnotesize\sffamily\bfseries\textcolor{ThesisPrimary}{#3}}%
    }%
  }

  \NewDocumentCommand{\ocgstack}{O{both} +m +m}{%
    \par\noindent%
    \begin{tikzpicture}[remember picture=false]%
      \node[inner sep=0pt, text width=\linewidth, align=flush left, anchor=north west] at (0,0) {%
        #2%
      };%
      \node[inner sep=0pt, text width=\linewidth, align=flush left, anchor=north west] at (0,0) {%
        #3%
      };%
    \end{tikzpicture}\par%
  }

  \NewDocumentCommand{\ocgstackthree}{O{all} +m +m +m}{%
    \par\noindent%
    \begin{tikzpicture}[remember picture=false]%
      \node[inner sep=0pt, text width=\linewidth, align=flush left, anchor=north west] at (0,0) {%
        #2%
      };%
      \node[inner sep=0pt, text width=\linewidth, align=flush left, anchor=north west] at (0,0) {%
        #3%
      };%
      \node[inner sep=0pt, text width=\linewidth, align=flush left, anchor=north west] at (0,0) {%
        #4%
      };%
    \end{tikzpicture}\par%
  }
\fi

% --- Inclusion propre de documents PDF externes (paquet pdfpages) ---
% Préserve le folio et les en-têtes de la thèse avec facteur d'échelle sécurisé
\newcommand{\includepdfpaper}[2][pages=-]{%
  \includepdf[%
    #1,%
    scale=0.82,%
    pagecommand={\thispagestyle{scrheadings}}%
  ]{#2}%
}

