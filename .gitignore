*.nav
*.snm
*.vrb
*.bcf
*.run.xml
*.idx
*.ilg
*.ind
*.glo
*.gls
*.glg
*.brf
*.upa
*.upb

# Output and temporary directories
build/
dist/
out/
_minted-*/
auto/

# OS Artifacts
.DS_Store
Thumbs.db