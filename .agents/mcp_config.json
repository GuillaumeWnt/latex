{
  "mcpServers": {
    "arxiv-latex": {
      "command": "uvx",
      "args": [
        "arxiv-latex-mcp"
      ]
    },
    "zotero-citations": {
      "command": "npx",
      "args": [
        "-y",
        "@oscardvs/zoteus"
      ],
      "env": {
        "ZOTEUS_LOCAL": "true"
      }
    }
  }
}
