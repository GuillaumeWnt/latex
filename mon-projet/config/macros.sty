%% ==============================================================================
%% config/macros.sty
%% Commandes métier, raccourcis mathématiques et environnements personnalisés
%% ==============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{config/macros}[2026/10/17 v1.0 Custom Macros for mythesis]

% --- Notations mathématiques sémantiques ---
% Vecteurs et matrices en gras droit / italique
\newcommand{\vect}[1]{\boldsymbol{\mathbf{#1}}}
\newcommand{\mat}[1]{\mathbf{#1}}

% Ensembles usuels
\newcommand{\setR}{\mathbb{R}}
\newcommand{\setN}{\mathbb{N}}
\newcommand{\setZ}{\mathbb{Z}}
\newcommand{\setC}{\mathbb{C}}

% Délimiteurs extensibles via mathtools
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\DeclarePairedDelimiter{\scal}{\langle}{\rangle}

% Symbole différentiel droit pour le calcul intégral
\newcommand{\diff}{\mathop{}\!\mathrm{d}}

% Opérateurs d'optimisation
\DeclareMathOperator*{\argmin}{\arg\min}
\DeclareMathOperator*{\argmax}{\arg\max}
\DeclareMathOperator{\trace}{\mathrm{Tr}}
\DeclareMathOperator{\diag}{\mathrm{diag}}

% --- Balisage textuel sémantique ---
% Terme technique introduit pour la première fois
\newcommand{\term}[1]{\textbf{\textcolor{ThesisPrimary}{#1}}}

% Fragment de code en ligne
\newcommand{\code}[1]{\texttt{\textcolor{ThesisPrimary!90}{#1}}}

% --- Environnements visuels (tcolorbox) ---

% Boîte d'information / Remarque
\newtcolorbox{callout}[1][Remarque]{%
  enhanced,
  breakable,
  colback=ThesisPrimary!4,
  colframe=ThesisPrimary!70,
  coltitle=ThesisPrimary,
  fonttitle=\bfseries\sffamily\small,
  title={#1},
  left=10pt,
  right=10pt,
  top=6pt,
  bottom=6pt,
  arc=3pt,
  boxrule=0.8pt,
  before skip=12pt,
  after skip=12pt
}

% Boîte d'hypothèse scientifique numérotée
\newcounter{hypocounter}[chapter]
\renewcommand{\thehypocounter}{\thechapter.\arabic{hypocounter}}

\newtcolorbox[use counter=hypocounter]{hypothesis}[1][]{%
  enhanced,
  breakable,
  colback=ThesisSecondary!4,
  colframe=ThesisSecondary!80,
  coltitle=ThesisSecondary,
  fonttitle=\bfseries\sffamily\small,
  title={Hypothèse~\thehypocounter\ifstrempty{#1}{}{ : #1}},
  left=10pt,
  right=10pt,
  top=6pt,
  bottom=6pt,
  arc=3pt,
  boxrule=0.9pt,
  before skip=12pt,
  after skip=12pt
}

% Boîte de définition formelle
\newcounter{deficounter}[chapter]
\renewcommand{\thedeficounter}{\thechapter.\arabic{deficounter}}

\newtcolorbox[use counter=deficounter]{definitionbox}[1][]{%
  enhanced,
  breakable,
  colback=ThesisBackground,
  colframe=ThesisPrimary!90,
  coltitle=white,
  colbacktitle=ThesisPrimary!90,
  fonttitle=\bfseries\sffamily\small,
  title={Définition~\thedeficounter\ifstrempty{#1}{}{ --- #1}},
  left=10pt,
  right=10pt,
  top=6pt,
  bottom=6pt,
  arc=2pt,
  boxrule=0.8pt,
  before skip=12pt,
  after skip=12pt
}

% Déclaration des alias cleveref pour nos compteurs personnalisés
\crefname{hypocounter}{hypothèse}{hypothèses}
\Crefname{hypocounter}{Hypothèse}{Hypothèses}
\crefname{deficounter}{définition}{définitions}
\Crefname{deficounter}{Définition}{Définitions}

% --- Configuration du style de code source externe (listings/) ---
\lstdefinestyle{mythesiscode}{
  basicstyle=\ttfamily\footnotesize,
  backgroundcolor=\color{ThesisBackground},
  keywordstyle=\color{ThesisPrimary}\bfseries,
  commentstyle=\color{ThesisMuted}\itshape,
  stringstyle=\color{ThesisAccent},
  numberstyle=\tiny\color{ThesisMuted},
  numbers=left,
  numbersep=8pt,
  stepnumber=1,
  frame=single,
  rulecolor=\color{ThesisSecondary!30},
  framesep=4pt,
  breaklines=true,
  breakatwhitespace=true,
  tabsize=2,
  showstringspaces=false,
  captionpos=b,
  keepspaces=true
}
\lstset{style=mythesiscode}

\crefname{lstlisting}{listing}{listings}
\Crefname{lstlisting}{Listing}{Listings}

% --- Macros d'interactivité PDF intelligente : profil écran vs profil impression ---

\ifprintversion
  % ============================================================================
  % PROFIL IMPRESSION PAPIER (print) :
  % - Neutralisation totale des calques PDF pour un rendu 100% statique et lisible
  % - Omission complète des boutons de bascule (inopérants sur papier)
  % - Aplatissement linéaire propre des vues pour le lecteur papier et l'imprimeur
  % ============================================================================
  \RenewDocumentEnvironment{ocg}{O{} m m m}{%
    \begingroup
  }{%
    \endgroup
  }

  % Les boutons interactifs sont strictement omis sur le papier
  \newcommand{\ocgbutton}[2]{\relax}
  \newcommand{\ocgselectbutton}[3]{\relax}

  % Gestionnaire d'affichage statique pour l'impression papier
  \long\def\@thesis@ocgstack@both#1#2{#1\par\vspace{10pt}\noindent#2}
  \long\def\@thesis@ocgstack@first#1#2{#1}
  \long\def\@thesis@ocgstack@second#1#2{#2}

  \NewDocumentCommand{\ocgstack}{O{both} +m +m}{%
    \par\noindent%
    \csname @thesis@ocgstack@#1\endcsname{#2}{#3}%
    \par%
  }

  \NewDocumentCommand{\ocgstackthree}{O{all} +m +m +m}{%
    \par\noindent%
    #2\par\vspace{10pt}\noindent#3\par\vspace{10pt}\noindent#4\par%
  }
\else
  % ============================================================================
  % PROFIL ÉCRAN NUMÉRIQUE (screen) :
  % - Calques PDF interactifs dynamiques (paquet ocgx2)
  % - Boutons cliquables de bascule instantanée
  % - Superposition géométrique parfaite TikZ à l'ancrage (north west à 0,0)
  % ============================================================================
  \newcommand{\ocgbutton}[2]{%
    \switchocg{#1}{%
      \setlength{\fboxsep}{3.5pt}%
      \fcolorbox{ThesisSecondary!30}{ThesisBackground}{%
        \small\sffamily\bfseries\textcolor{ThesisPrimary}{#2}%
      }%
    }%
  }

  \newcommand{\ocgselectbutton}[3]{%
    \actionsocg{}{#1}{#2}{%
      \setlength{\fboxsep}{3.5pt}%
      \fcolorbox{ThesisSecondary!30}{ThesisBackground}{%
        \small\sffamily\bfseries\textcolor{ThesisPrimary}{#3}%
      }%
    }%
  }

  \NewDocumentCommand{\ocgstack}{O{both} +m +m}{%
    \par\noindent%
    \begin{tikzpicture}[remember picture=false]%
      \node[inner sep=0pt, text width=\linewidth, align=flush left, anchor=north west] at (0,0) {%
        #2%
      };%
      \node[inner sep=0pt, text width=\linewidth, align=flush left, anchor=north west] at (0,0) {%
        #3%
      };%
    \end{tikzpicture}\par%
  }

  \NewDocumentCommand{\ocgstackthree}{O{all} +m +m +m}{%
    \par\noindent%
    \begin{tikzpicture}[remember picture=false]%
      \node[inner sep=0pt, text width=\linewidth, align=flush left, anchor=north west] at (0,0) {%
        #2%
      };%
      \node[inner sep=0pt, text width=\linewidth, align=flush left, anchor=north west] at (0,0) {%
        #3%
      };%
      \node[inner sep=0pt, text width=\linewidth, align=flush left, anchor=north west] at (0,0) {%
        #4%
      };%
    \end{tikzpicture}\par%
  }
\fi

% --- Inclusion propre de documents PDF externes (paquet pdfpages) ---
% Préserve le folio et les en-têtes de la thèse avec facteur d'échelle sécurisé
\newcommand{\includepdfpaper}[2][pages=-]{%
  \includepdf[%
    #1,%
    scale=0.82,%
    pagecommand={\thispagestyle{scrheadings}}%
  ]{#2}%
}

\endinput

