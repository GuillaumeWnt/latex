%% ==============================================================================
%% config/packages.sty
%% Appel et configuration centralisée des packages tiers
%% ==============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{config/packages}[2026/10/17 v1.0 Packages Configuration for mythesis]

% --- Détection du moteur et polices de caractères ---
\RequirePackage{iftex}
\ifluatex
  \RequirePackage{fontspec}
  \defaultfontfeatures{Ligatures=TeX}
  % Chargement des polices locales figées dans fonts/ (reproductibilité 100 % CI/CD et Overleaf)
  \IfFileExists{fonts/texgyreheros-regular.otf}{%
    \setsansfont{texgyreheros}[
      Path = fonts/,
      Extension = .otf,
      UprightFont = *-regular,
      BoldFont = *-bold,
      ItalicFont = *-italic,
      BoldItalicFont = *-bolditalic
    ]%
  }{}%
\else\ifxetex
  \RequirePackage{fontspec}
  \defaultfontfeatures{Ligatures=TeX}
  \IfFileExists{fonts/texgyreheros-regular.otf}{%
    \setsansfont{texgyreheros}[
      Path = fonts/,
      Extension = .otf,
      UprightFont = *-regular,
      BoldFont = *-bold,
      ItalicFont = *-italic,
      BoldItalicFont = *-bolditalic
    ]%
  }{}%
\else
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \RequirePackage{lmodern}
\fi\fi

% Micro-typographie (crénage optique, saillie des marges)
\RequirePackage{microtype}

% --- Langues et typographie internationale ---
% Le français est déclaré en dernier pour être la langue par défaut
\RequirePackage[english, french]{babel}
% Neutralisation de l'avertissement informatif de babel-french sur les listes expérimentales
\makeatletter
\global\let\warning@FBlegacylists\relax
\makeatother

% Guillemets automatiques et adaptés à la langue active
\RequirePackage[autostyle=true]{csquotes}

% --- Outils mathématiques modernes ---
\RequirePackage{amsmath}
\RequirePackage{mathtools}
\RequirePackage{amssymb}
\RequirePackage{amsthm}

% --- Tableaux professionnels (règles strictes booktabs) ---
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{makecell}
\RequirePackage{multirow}

% Espacement vertical accru dans les cellules de tableau
\renewcommand{\arraystretch}{1.15}

% --- Grandeurs physiques et unités SI ---
\RequirePackage{siunitx}
\sisetup{
  locale = FR,
  detect-all = true,
  group-minimum-digits = 4,
  uncertainty-mode = separate
}
\DeclareSIUnit\iter{it}

% --- Graphiques et figures vectorielles TikZ & Standalone ---
\RequirePackage{graphicx}
\graphicspath{{figures/}{figures/tikz/}}

% --- Insertion propre de documents PDF multipages externes ---
\RequirePackage{pdfpages}

% --- Calques PDF natifs et interactivité légère (OCG ISO 32000-1) ---
\RequirePackage{ocgx2}

\RequirePackage{standalone}
\RequirePackage{tikz}
\usetikzlibrary{
  arrows.meta,
  positioning,
  calc,
  fit,
  backgrounds,
  shapes.geometric
}

