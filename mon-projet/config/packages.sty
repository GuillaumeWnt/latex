% Boîtes d'enrichissement visuel (callouts, encadrés)
\RequirePackage[skins, breakable]{tcolorbox}

% --- Courbes scientifiques de données brutes (data/*.csv) ---
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

% --- Inclusion et coloration de code source externe (listings/*.py) ---
\RequirePackage{listings}

% --- En-têtes et pieds de page KOMA-Script ---
\RequirePackage[headsepline=0.5pt]{scrlayer-scrpage}
\addtokomafont{headsepline}{\color{ThesisSecondary!40}}

% --- Bibliographie BibLaTeX ---
% Le style fait appel à biblio/custom-style.bbx et biblio/custom-style.cbx
\RequirePackage[
  backend=biber,
  style=biblio/custom-style
]{biblatex}

% --- Navigation hypertexte et métadonnées PDF ---
\RequirePackage{hyperref}

% Référencement croisé intelligent (doit impérativement être chargé après hyperref)
\RequirePackage[capitalise, noabbrev, french]{cleveref}

