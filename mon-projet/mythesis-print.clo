%% ==============================================================================
%% mythesis-print.clo
%% Option de classe : Configuration optimisée pour l'impression papier et la reliure
%% ==============================================================================
\ProvidesFile{mythesis-print.clo}[2026/10/17 v1.0 Print Layout Configuration for mythesis]

% --- Géométrie et mise en page KOMA-Script ---
% Recto-verso avec décalage de reliure (BCOR) et début des chapitres sur page impaire
\KOMAoptions{
  twoside=true,
  open=right,
  BCOR=10mm,
  DIV=12
}
\recalctypearea

% --- Palette chromatique pour impression (Économie de toner & Contraste) ---
\definecolor{ThesisPrimary}{RGB}{20, 20, 25}      % Noir chaud / graphite très profond
\definecolor{ThesisSecondary}{RGB}{60, 65, 75}    % Gris foncé texturé
\definecolor{ThesisAccent}{RGB}{80, 85, 95}       % Gris moyen soutenu
\definecolor{ThesisText}{RGB}{0, 0, 0}            % Noir pur pour une netteté maximale à l'impression
\definecolor{ThesisMuted}{RGB}{110, 115, 120}    % Gris intermédiaire
\definecolor{ThesisBackground}{RGB}{245, 245, 245}% Fond gris très pâle

% Liens hypertexte discrets (pas de couleur criarde sur papier)
\definecolor{ThesisLink}{RGB}{0, 0, 0}
\definecolor{ThesisCite}{RGB}{0, 0, 0}
\definecolor{ThesisUrl}{RGB}{0, 0, 0}

% Configuration Hyperref spécifique à l'impression : les liens restent fonctionnels
% dans le PDF numérique, mais s'impriment en noir sans bordure ni couleur vive.
\PassOptionsToPackage{
  colorlinks=false,
  hidelinks,
  bookmarksopen=false,
  bookmarksnumbered=true,
  pdfpagemode=UseNone,
  pdfdisplaydoctitle=true
}{hyperref}

\endinput

